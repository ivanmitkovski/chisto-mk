# Reverse proxy for the Chisto stack — the only container exposed to the network.
#
# The same file serves local and production; only the site address differs.
#
#   local (default)  CADDY_SITE_ADDRESS=:80        plain HTTP, no certificates
#   production       CADDY_SITE_ADDRESS=api.chisto.mk
#
# A bare ":80" has no hostname, so Caddy cannot and does not attempt automatic
# HTTPS. Supplying a real hostname is by itself what switches on Let's Encrypt,
# the HTTP->HTTPS redirect and renewal. There is no flag to remember.
#
# One hostname covers both the API and media, so there is one certificate and
# no second domain to manage.

{$CADDY_SITE_ADDRESS::80} {
	# MinIO. S3_FORCE_PATH_STYLE=true puts the bucket name first in the path,
	# so this prefix is the entire media surface. Keep in sync with
	# S3_BUCKET_NAME if that ever changes.
	#
	# Caddy passes the original Host header through unchanged, which is what
	# makes presigned URLs validate: the API signs for this hostname and MinIO
	# verifies the signature against the same one.
	handle /chisto-media/* {
		reverse_proxy minio:9000
	}

	handle {
		# flush_interval -1 disables response buffering: admin uses SSE and
		# mobile uses Socket.IO, and both break if the proxy buffers them.
		# Caddy upgrades WebSocket connections without extra configuration.
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	# The API sets `trust proxy`, so it reads the client IP from the
	# X-Forwarded-For header Caddy sets here. Rate limiting depends on it.
	log {
		output stdout
		format console
	}
}
