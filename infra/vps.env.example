# Template for the VPS. Copy to infra/vps.env on the box and fill in.
# Also copy the interpolation vars (marked below) into the repo-root .env, which
# is what Compose reads for ${VAR} substitution in the compose files.
#
#   cp infra/vps.env.example infra/vps.env
#
# Never commit either file. The pre-commit hook blocks .env; keep vps.env out of
# git the same way.
#
# Anything marked REQUIRED is enforced at boot by validateEnv()
# (apps/api/src/config/env.ts) — the API exits rather than starting degraded.

# ---------------------------------------------------------------------------
# Read by Compose itself (put these in the repo-root .env, not only here)
# ---------------------------------------------------------------------------

# Makes `docker compose up -d` include the production overlay automatically.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# The public hostname. Drives the Caddy site address (and therefore automatic
# HTTPS), the Docker network alias, and S3_ENDPOINT_URL — so presigned media
# URLs are signed for a name phones can actually resolve.
# Use vps.chisto.mk while rehearsing, api.chisto.mk at cutover.
PUBLIC_HOST=api.chisto.mk

POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Core secrets (REQUIRED)
# ---------------------------------------------------------------------------

# Min 32 characters.
JWT_SECRET=

# EXACTLY 64 hex characters, and it CANNOT be regenerated. Export the existing
# value from AWS Secrets Manager (chisto/production/api) before the account is
# suspended — a new key makes all stored event-chat messages permanently
# undecryptable.
CHAT_ENCRYPTION_KEY=

# Min 24 characters each. Also in the same AWS secret.
CHECK_IN_QR_SECRET=
SITE_SHARE_TOKEN_SECRET=

# Guards the /metrics endpoint.
METRICS_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# URLs (REQUIRED)
# ---------------------------------------------------------------------------

# Comma-separated. The admin dashboard and landing site origins.
CORS_ORIGINS=https://admin.chisto.mk,https://chisto.mk

# Must not point at localhost in production.
ADMIN_APP_BASE_URL=https://admin.chisto.mk

# ---------------------------------------------------------------------------
# Twilio (REQUIRED — production refuses SMS_PROVIDER=none)
# ---------------------------------------------------------------------------
# Phone OTP is the login path, so without these nobody can sign in.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_BASE_URL=https://api.chisto.mk

# At least one sender path is required.
TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_PHONE_NUMBER=
# TWILIO_ALPHANUMERIC_SENDER=

# ---------------------------------------------------------------------------
# Optional integrations — each becomes REQUIRED once its feature is enabled
# ---------------------------------------------------------------------------

# EMAIL_ENABLED=true then requires all three.
EMAIL_ENABLED=false
# POSTMARK_SERVER_TOKEN=
# POSTMARK_WEBHOOK_BASIC_USER=
# POSTMARK_WEBHOOK_BASIC_PASS=

# PUSH_FCM_ENABLED=true then requires the service account JSON.
PUSH_FCM_ENABLED=false
# FIREBASE_SERVICE_ACCOUNT_JSON=

# SENTRY_DSN=
