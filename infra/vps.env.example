# Template for the VPS. Copy to infra/vps.env on the box and fill in.
# Also copy the interpolation vars (marked below) into the repo-root .env, which
# is what Compose reads for ${VAR} substitution in the compose files.
#
#   cp infra/vps.env.example infra/vps.env
#
# Never commit either file. The pre-commit hook blocks .env; keep vps.env out of
# git the same way.
#
# Anything marked REQUIRED is enforced at boot by validateEnv()
# (apps/api/src/config/env.ts) — the API exits rather than starting degraded.
# The values below are the ones production actually ran on ECS, not guesses.
#
# ---------------------------------------------------------------------------
# READ THIS FIRST: escape every '$' as '$$'
# ---------------------------------------------------------------------------
# Compose applies variable interpolation to values in BOTH .env and env_file, so
# a single '$' is read as the start of a variable name and the value is silently
# truncated from that point on ("abc$xyzdef" becomes "abc"). '$$' yields a
# literal '$'.
#
# This is not hypothetical: the production SITE_SHARE_TOKEN_SECRET contains a
# '$', and truncated it is still over the 24-character minimum — so validateEnv()
# passes, the API boots, and every existing share link fails verification with
# nothing logged anywhere. Escape all values, uniformly.

# ---------------------------------------------------------------------------
# Read by Compose itself (put these in the repo-root .env, not only here)
# ---------------------------------------------------------------------------

# Makes `docker compose up -d` include the production overlay automatically.
# Add :docker-compose.rehearsal.yml while rehearsing without TLS; removing that
# entry is what promotes the box to production.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# The public hostname. Drives the Caddy site address (and therefore automatic
# HTTPS), the Docker network alias, and S3_ENDPOINT_URL — so presigned media
# URLs are signed for a name phones can actually resolve.
# Use vps.chisto.mk while rehearsing, api.chisto.mk at cutover.
PUBLIC_HOST=api.chisto.mk

POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# NOT a free choice. s3-storage.client.ts builds its canonical media URL as
# https://${S3_BUCKET_NAME}.s3.${AWS_REGION}.amazonaws.com/ — a synthetic string
# used only as an internal encoding of bucket+key, never fetched. signUrls()
# strips that prefix to recover the key and presigns against the real endpoint,
# and returns anything that does not match unsigned and broken. Rows migrated
# from AWS already store that string with this bucket and region, so changing
# either value breaks existing media. infra/Caddyfile routes the media prefix
# from S3_BUCKET_NAME for the same reason — bucket and route must agree.
S3_BUCKET_NAME=chisto-prod-media
AWS_REGION=eu-central-1

# ---------------------------------------------------------------------------
# Core secrets (REQUIRED)
# ---------------------------------------------------------------------------

# Min 32 characters.
JWT_SECRET=

# EXACTLY 64 hex characters, and it CANNOT be regenerated. Export the existing
# value from AWS Secrets Manager (chisto/production/api) — a new key makes all
# stored event-chat messages permanently undecryptable.
CHAT_ENCRYPTION_KEY=

# Min 24 characters each. Also in the same AWS secret.
CHECK_IN_QR_SECRET=
SITE_SHARE_TOKEN_SECRET=

# Guards the /metrics endpoint.
METRICS_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# URLs (REQUIRED)
# ---------------------------------------------------------------------------

# Browser origins allowed to call the API. Production runs the admin dashboard
# ONLY — landing calls the API server-side and needs no CORS entry. Do not widen
# this to include chisto.mk without a reason.
CORS_ORIGINS=https://admin.chisto.mk

# Must not point at localhost in production.
ADMIN_APP_BASE_URL=https://admin.chisto.mk

# Websocket origins for event chat — these DO include landing.
CHAT_WS_CORS_ORIGINS=https://admin.chisto.mk,https://chisto.mk

# Base for generated share links.
SHARE_BASE_URL=https://chisto.mk

# ---------------------------------------------------------------------------
# Proxy trust (REQUIRED behind Caddy)
# ---------------------------------------------------------------------------
# The API reads the client IP from the X-Forwarded-For header Caddy sets, but
# only trusts it from a listed CIDR. Set this to the Docker bridge subnet, NOT
# the old AWS VPC CIDR — with a wrong value every client IP reads as the proxy's
# and rate limiting, login-failure tracking and GeoIP all key on one address.
#
#   docker network inspect chisto_default -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
#
# Trust the subnet rather than a container IP: container addresses are
# reassigned across restarts.
TRUSTED_PROXY_CIDRS=172.18.0.0/16

# ---------------------------------------------------------------------------
# Twilio (REQUIRED — production refuses SMS_PROVIDER=none)
# ---------------------------------------------------------------------------
# Phone OTP is the login path, so without these nobody can sign in.
#
# TWILIO_WEBHOOK_BASE_URL does NOT tell Twilio where to send; it is used only to
# rebuild the URL string that validates inbound webhook signatures. Leave the
# console's webhook URL pointing at api.chisto.mk — it follows DNS at cutover by
# itself, and repointing it at a rehearsal host breaks delivery callbacks for
# live users.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_BASE_URL=https://api.chisto.mk

# At least one sender path is required.
TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_PHONE_NUMBER=
# TWILIO_ALPHANUMERIC_SENDER=

# ---------------------------------------------------------------------------
# Email — ON in production, so all three Postmark values are REQUIRED
# ---------------------------------------------------------------------------
EMAIL_ENABLED=true
POSTMARK_SERVER_TOKEN=
POSTMARK_WEBHOOK_BASIC_USER=
POSTMARK_WEBHOOK_BASIC_PASS=
EMAIL_FROM_NAME=Chisto.mk
EMAIL_APP_BASE_URL=https://chisto.mk
EMAIL_PUBLIC_API_BASE_URL=https://api.chisto.mk

# ---------------------------------------------------------------------------
# Push — ON in production, so the service account JSON is REQUIRED
# ---------------------------------------------------------------------------
# Single-line JSON. Note the service account exported from AWS has project_id
# chisto-mk-dev; confirm that is really the intended FCM project before relying
# on push, since there are live device tokens in the database.
PUSH_FCM_ENABLED=true
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# Feature flags and tuning — production values, carried over so behaviour does
# not change silently on a new host
# ---------------------------------------------------------------------------
# Leaving NOTIFICATIONS_INBOX_ENABLED at true (or PG_OUTBOX_LISTEN unset) makes
# REDIS_URL required; the compose files already provide it.
NOTIFICATIONS_INBOX_ENABLED=true
GEOIP_ENABLED=false

JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_DAYS=90
JWT_REFRESH_STANDARD_DAYS=7
MAX_SESSIONS_PER_USER=20
REFRESH_TOKEN_ROTATION_GRACE_SECONDS=120

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=      # 0..1 when SENTRY_DSN is set
#
# Both default OFF and each becomes REQUIRED only if switched on:
#   MAP_SEARCH_TYPESENSE=true  -> TYPESENSE_HOST, TYPESENSE_API_KEY
#   MAP_OFFLINE_REGIONS=true   -> MAP_OFFLINE_REGIONS_MANIFEST_JSON and/or S3_BUCKET_NAME
